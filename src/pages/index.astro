---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Brightside DJs | Premium Event Entertainment">
	<main>
		<!-- Navigation -->
		<nav class="fixed w-full z-50 bg-[#020617]/80 backdrop-blur-md border-b border-slate-800/50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between h-20 items-center">
					<div class="flex-shrink-0">
						<span class="text-2xl font-extrabold tracking-tighter text-white">BRIGHTSIDE<span class="text-amber-500">DJs</span></span>
					</div>
					<div class="hidden md:block">
						<div class="ml-10 flex items-baseline space-x-8">
							<a href="#services" class="text-slate-300 hover:text-amber-500 px-3 py-2 text-sm font-medium transition-colors">Services</a>
							<a href="#about" class="text-slate-300 hover:text-amber-500 px-3 py-2 text-sm font-medium transition-colors">About</a>
							<a href="#testimonials" class="text-slate-300 hover:text-amber-500 px-3 py-2 text-sm font-medium transition-colors">Reviews</a>
							<a href="#contact" class="bg-amber-500 text-slate-950 px-6 py-2 rounded-full text-sm font-bold hover:bg-amber-400 hover:shadow-[0_0_20px_rgba(245,158,11,0.4)] transition-all transform hover:-translate-y-0.5">Get Quote</a>
						</div>
					</div>
				</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="relative h-screen flex items-center overflow-hidden">
			<div class="absolute inset-0 z-0">
				<img 
					src="https://images.unsplash.com/photo-1514525253361-bee8718a300c?auto=format&fit=crop&q=80&w=2000" 
					class="w-full h-full object-cover opacity-30"
					alt="DJ performing at a club"
				/>
				<div class="absolute inset-0 bg-gradient-to-b from-[#020617]/80 via-[#020617]/40 to-[#020617]"></div>
			</div>
			
			<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h1 class="text-5xl md:text-8xl font-black tracking-tight mb-6 animate-fade-in leading-[1.1]">
					YOUR NIGHT.<br/>YOUR STORY.<br/><span class="text-amber-500">YOUR SOUNDTRACK.</span>
				</h1>
				<p class="text-xl md:text-2xl text-slate-400 max-w-3xl mx-auto mb-10 leading-relaxed">
					Boutique event entertainment for those who value incredible music and seamless production. Based in West Kelowna, serving the Okanagan and beyond.
				</p>
				<div class="flex flex-col sm:flex-row justify-center gap-4 animate-fade-in-delay">
					<a href="#contact" class="bg-amber-500 text-slate-950 px-10 py-4 rounded-full text-lg font-bold hover:bg-amber-400 hover:shadow-[0_0_30px_rgba(245,158,11,0.3)] transition-all transform hover:-translate-y-1">Book Your Date</a>
					<a href="#services" class="bg-transparent border-2 border-slate-700 hover:border-amber-500 text-white px-10 py-4 rounded-full text-lg font-bold transition-all transform hover:-translate-y-1">Explore Services</a>
				</div>
			</div>
		</section>

		<!-- Stats Bar -->
		<section class="relative z-20 -mt-12 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="bg-slate-900/90 backdrop-blur-xl border border-slate-800 rounded-3xl p-8 md:p-12 shadow-2xl">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-0 divide-y md:divide-y-0 md:divide-x divide-slate-800 text-center">
					<div class="md:px-4">
						<p class="text-4xl md:text-5xl font-black text-amber-500 mb-1">100+</p>
						<p class="text-slate-400 font-bold uppercase tracking-widest text-xs">Weddings</p>
					</div>
					<div class="pt-8 md:pt-0 md:px-4">
						<p class="text-4xl md:text-5xl font-black text-amber-500 mb-1">10+</p>
						<p class="text-slate-400 font-bold uppercase tracking-widest text-xs">Years Exp.</p>
					</div>
					<div class="pt-8 md:pt-0 md:px-4">
						<p class="text-4xl md:text-5xl font-black text-amber-500 mb-1">5★</p>
						<p class="text-slate-400 font-bold uppercase tracking-widest text-xs">Rating</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Services Section -->
		<section id="services" class="py-32 bg-[#020617]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-24">
					<h2 class="text-4xl md:text-6xl font-black mb-6 tracking-tight">EXPERIENCES WE CRAFT</h2>
					<div class="w-24 h-2 bg-amber-500 mx-auto rounded-full"></div>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
					<!-- Weddings (Prominent) -->
					<div class="lg:col-span-2 group relative overflow-hidden rounded-3xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 transition-all shadow-xl hover:shadow-amber-500/10">
						<div class="h-64 overflow-hidden">
							<img src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&q=80&w=1200" alt="Wedding DJ" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
							<div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent"></div>
						</div>
						<div class="p-10 -mt-12 relative">
							<div class="inline-block bg-amber-500 text-slate-950 text-xs font-black px-3 py-1 rounded-full mb-4 uppercase tracking-widest">Most Popular</div>
							<h3 class="text-3xl font-bold mb-4">Weddings</h3>
							<p class="text-slate-400 mb-8 leading-relaxed">Your special day deserves more than just a playlist. We create an atmosphere that reflects your journey, from the ceremony to the final floor-shaking anthem.</p>
							<div class="grid grid-cols-2 gap-4 mb-8">
								<ul class="text-slate-500 space-y-2 text-sm">
									<li class="flex items-center"><span class="text-amber-500 mr-2">✦</span> Custom Curation</li>
									<li class="flex items-center"><span class="text-amber-500 mr-2">✦</span> Professional MC</li>
								</ul>
								<ul class="text-slate-500 space-y-2 text-sm">
									<li class="flex items-center"><span class="text-amber-500 mr-2">✦</span> Timeline Planning</li>
									<li class="flex items-center"><span class="text-amber-500 mr-2">✦</span> Wireless Audio</li>
								</ul>
							</div>
						</div>
					</div>

					<!-- Private Parties -->
					<div class="group relative overflow-hidden rounded-3xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 transition-all shadow-xl">
						<div class="h-48 overflow-hidden">
							<img src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&q=80&w=800" alt="Private Party" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
						</div>
						<div class="p-8">
							<h3 class="text-2xl font-bold mb-4">Private Parties</h3>
							<p class="text-slate-400 mb-6 text-sm">Birthdays, anniversaries, or backyard bashes. We bring club-level energy to your private space.</p>
							<ul class="text-slate-500 space-y-2 text-sm mb-8">
								<li class="flex items-center"><span class="text-amber-500 mr-2">✦</span> Multi-Genre DJs</li>
								<li class="flex items-center"><span class="text-amber-500 mr-2">✦</span> Compact Setup</li>
								<li class="flex items-center"><span class="text-amber-500 mr-2">✦</span> High Energy</li>
							</ul>
						</div>
					</div>

					<!-- Corporate -->
					<div class="group relative overflow-hidden rounded-3xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 transition-all shadow-xl">
						<div class="h-48 overflow-hidden">
							<img src="https://images.unsplash.com/photo-1505373877841-8d25f7d46678?auto=format&fit=crop&q=80&w=800" alt="Corporate Event" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
						</div>
						<div class="p-8">
							<h3 class="text-2xl font-bold mb-4">Corporate</h3>
							<p class="text-slate-400 mb-6 text-sm">Galas, holiday parties, and launches. Professional, reliable, and perfectly tailored to your brand.</p>
							<ul class="text-slate-500 space-y-2 text-sm mb-8">
								<li class="flex items-center"><span class="text-amber-500 mr-2">✦</span> Clean Presentation</li>
								<li class="flex items-center"><span class="text-amber-500 mr-2">✦</span> Professional Gear</li>
								<li class="flex items-center"><span class="text-amber-500 mr-2">✦</span> Liaison Services</li>
							</ul>
						</div>
					</div>

					<!-- Lighting Design (NEW) -->
					<div class="lg:col-span-4 group relative overflow-hidden rounded-3xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 transition-all shadow-xl mt-4">
						<div class="grid grid-cols-1 md:grid-cols-2 items-center">
							<div class="h-64 md:h-full overflow-hidden">
								<img src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&q=80&w=1200" alt="Lighting Design" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000" />
							</div>
							<div class="p-10">
								<div class="inline-block bg-white/10 text-white text-[10px] font-black px-2 py-0.5 rounded-full mb-4 uppercase tracking-[0.2em]">New for 2026</div>
								<h3 class="text-3xl font-bold mb-4">Lighting Design</h3>
								<p class="text-slate-400 mb-8 leading-relaxed">Transform any venue with our bespoke lighting packages. From elegant uplighting to high-impact moving heads, we paint your space with light.</p>
								<div class="flex flex-wrap gap-4">
									<span class="bg-slate-800 text-slate-300 px-4 py-2 rounded-xl text-xs font-bold">Intelligent Lighting</span>
									<span class="bg-slate-800 text-slate-300 px-4 py-2 rounded-xl text-xs font-bold">Atmospheric Effects</span>
									<span class="bg-slate-800 text-slate-300 px-4 py-2 rounded-xl text-xs font-bold">Custom Gobos</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Social Proof Section -->
		<section id="testimonials" class="py-32 bg-[#020617]/50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-24">
					<h2 class="text-4xl md:text-6xl font-black mb-6 tracking-tight">KIND WORDS</h2>
					<div class="w-24 h-2 bg-amber-500 mx-auto rounded-full"></div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="bg-slate-900 p-10 rounded-3xl border border-slate-800 relative shadow-xl">
						<div class="flex text-amber-500 mb-6 text-xl">★★★★★</div>
						<p class="text-lg italic text-slate-300 mb-8 leading-relaxed">"Brightside DJs absolutely killed it at our wedding! The dance floor was packed from the first song to the last. Highly recommend!"</p>
						<div class="flex items-center">
							<div class="w-12 h-12 bg-slate-700 rounded-full mr-4 border border-slate-600"></div>
							<div>
								<p class="font-bold text-white">Sarah & James</p>
								<p class="text-xs text-slate-500 font-bold uppercase tracking-widest">Wedding Clients</p>
							</div>
						</div>
					</div>

					<div class="bg-slate-900 p-10 rounded-3xl border border-slate-800 relative shadow-xl">
						<div class="flex text-amber-500 mb-6 text-xl">★★★★★</div>
						<p class="text-lg italic text-slate-300 mb-8 leading-relaxed">"Incredible professionalism and production quality. They took our corporate gala to a whole new level."</p>
						<div class="flex items-center">
							<div class="w-12 h-12 bg-slate-700 rounded-full mr-4 border border-slate-600"></div>
							<div>
								<p class="font-bold text-white">Mark Thompson</p>
								<p class="text-xs text-slate-500 font-bold uppercase tracking-widest">Event Director, TechCorp</p>
							</div>
						</div>
					</div>

					<div class="bg-slate-900 p-10 rounded-3xl border border-slate-800 relative shadow-xl">
						<div class="flex text-amber-500 mb-6 text-xl">★★★★★</div>
						<p class="text-lg italic text-slate-300 mb-8 leading-relaxed">"The energy they brought was unmatched. Our 40th birthday bash was the talk of the town for weeks!"</p>
						<div class="flex items-center">
							<div class="w-12 h-12 bg-slate-700 rounded-full mr-4 border border-slate-600"></div>
							<div>
								<p class="font-bold text-white">Elena Rodriguez</p>
								<p class="text-xs text-slate-500 font-bold uppercase tracking-widest">Private Party Host</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section id="contact" class="py-32 relative overflow-hidden">
			<div class="absolute inset-0 bg-amber-500"></div>
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-amber-400 to-amber-500"></div>
			
			<div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-slate-950">
				<h2 class="text-5xl md:text-8xl font-black mb-10 tracking-tighter">READY TO BE LEGENDARY?</h2>
				<p class="text-xl md:text-2xl font-medium mb-16 max-w-2xl mx-auto leading-relaxed opacity-90 text-slate-900">Dates for 2026/2027 are filling up fast. Tell us about your event and we'll be in touch within 24 hours.</p>
				
				<form class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
					<div class="text-left">
						<label class="block text-xs font-black uppercase tracking-widest mb-2 ml-1">Full Name</label>
						<input type="text" class="w-full bg-white/40 backdrop-blur-md px-6 py-4 rounded-2xl border-2 border-slate-950/10 focus:border-slate-950 focus:ring-0 text-slate-950 placeholder-slate-700 font-bold transition-all" />
					</div>
					<div class="text-left">
						<label class="block text-xs font-black uppercase tracking-widest mb-2 ml-1">Email</label>
						<input type="email" class="w-full bg-white/40 backdrop-blur-md px-6 py-4 rounded-2xl border-2 border-slate-950/10 focus:border-slate-950 focus:ring-0 text-slate-950 placeholder-slate-700 font-bold transition-all" />
					</div>
					<div class="text-left">
						<label class="block text-xs font-black uppercase tracking-widest mb-2 ml-1">Date</label>
						<input type="date" class="w-full bg-white/40 backdrop-blur-md px-6 py-4 rounded-2xl border-2 border-slate-950/10 focus:border-slate-950 focus:ring-0 text-slate-950 font-bold transition-all" />
					</div>
					<div class="text-left">
						<label class="block text-xs font-black uppercase tracking-widest mb-2 ml-1">Event Type</label>
						<select class="w-full bg-white/40 backdrop-blur-md px-6 py-4 rounded-2xl border-2 border-slate-950/10 focus:border-slate-950 focus:ring-0 text-slate-950 font-bold transition-all">
							<option>Wedding</option>
							<option>Corporate</option>
							<option>Private Party</option>
							<option>Lighting Only</option>
						</select>
					</div>
					<button type="submit" class="sm:col-span-2 bg-slate-950 text-white font-black text-xl py-6 rounded-2xl hover:bg-slate-800 hover:shadow-2xl transition-all transform hover:-translate-y-1 mt-4">GET MY CUSTOM QUOTE</button>
				</form>
			</div>
		</section>

		<!-- Footer -->
		<footer class="py-20 bg-[#020617] border-t border-slate-900">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center">
				<div class="mb-12 md:mb-0 text-center md:text-left">
					<span class="text-2xl font-extrabold tracking-tighter text-white">BRIGHTSIDE<span class="text-amber-500">DJs</span></span>
					<p class="text-slate-500 text-sm mt-4 font-medium tracking-tight">Crafting legendary nights in West Kelowna since 2014.</p>
					<p class="text-slate-600 text-xs mt-2 uppercase tracking-widest font-black">© 2026 Brightside DJs. All Rights Reserved.</p>
				</div>
				<div class="flex space-x-8 text-slate-400">
					<a href="#" class="hover:text-amber-500 transition-colors font-black uppercase tracking-widest text-xs">Instagram</a>
					<a href="#" class="hover:text-amber-500 transition-colors font-black uppercase tracking-widest text-xs">Facebook</a>
					<a href="#" class="hover:text-amber-500 transition-colors font-black uppercase tracking-widest text-xs">Mixcloud</a>
				</div>
			</div>
		</footer>
	</main>
</Layout>

<style>
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(30px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.animate-fade-in {
		animation: fadeIn 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}
	.animate-fade-in-delay {
		opacity: 0;
		animation: fadeIn 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
	}
</style>
